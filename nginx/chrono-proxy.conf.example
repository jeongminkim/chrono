# 앱이 루트(/) 경로를 쓰므로 Chrono 전용 server 블록(도메인 또는 서브도메인)으로 구성합니다.
# 앱에는 자체 인증이 없습니다. 편집(삭제·수정) API가 있으므로 반드시 Nginx에서 인증을 걸어 주세요.
server {
    listen 80;
    server_name chrono.example.com;   # 실제 도메인으로 변경 (TLS 설정은 운영 환경에 맞게 추가)

    # 컨테이너 간 내부 API(/internal/)는 외부에 열지 않는다. location /보다 우선하도록 ^~ 를 쓴다.
    location ^~ /internal/ {
        return 404;
    }

    location / {
        # 인증 예시 (Basic Auth). 다른 방식(auth_request, OAuth 프록시 등)을 써도 됩니다.
        # htpasswd 파일 생성: htpasswd -c /etc/nginx/chrono.htpasswd <사용자>
        auth_basic "Chrono";
        auth_basic_user_file /etc/nginx/chrono.htpasswd;

        # 편집 화면의 이미지 업로드(최대 10MB). 기본값 1MB로는 대부분의 사진이 413 오류가 납니다.
        client_max_body_size 10m;

        proxy_pass http://chrono:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 앱은 이 헤더가 붙은 /internal/ 요청을 거부한다(차단 설정을 빠뜨렸을 때의 안전장치). 지우지 마세요.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
